{
  "$schema": "https://nuxiva.org/schemas/agent.manifest.json",
  "id": "sentinel_guardian",
  "name": "Sentinel Security Guardian",
  "version": "1.0.0",
  "kind": "agent",
  "role": "security",
  "author": "Nuxiva Cyber Defense",
  "capabilities": ["threat_analysis", "sandbox_enforcement", "audit_logging"],
