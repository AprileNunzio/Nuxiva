  "capabilities": ["reasoning.read", "reasoning.manage"],
  "ui": {
    "tabs": [
      { "id": "overview", "labelKey": "tab_overview", "icon": "overview" },
      { "id": "traces", "labelKey": "tab_traces", "icon": "diagnostics" },
      { "id": "settings", "labelKey": "tab_settings", "icon": "settings" }
    ],
    "actions": [
      { "id": "refresh", "labelKey": "os_refresh", "icon": "refresh-cw" }
    ],
    "statusBar": { "showConnectionState": true, "showItemCount": true }
