      ],
      "options": [
        {
          "value": "0",
          "label": "Lettura e scrittura"
        },
        {
          "value": "1",
          "label": "Sola lettura"
        }
      ]
    },
    {
      "key": "NUXIVA_SHARES_NETWORKS",
