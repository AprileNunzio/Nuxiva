    [
      "rtlwifi/*",
      {
        "apt": ["firmware-realtek"]
      }
    ],
    [
      "rtl_bt/*",
      {
        "apt": ["firmware-realtek"]
      }
    ],
    [
      "rtw88/*",
      {
        "apt": ["firmware-realtek"]
      }
    ],
    [
      "rtw89/*",
      {
        "apt": ["firmware-realtek"]
      }
    ],
    [
      "rt73.bin",
      {
        "apt": ["firmware-misc-nonfree", "firmware-mediatek"]
      }
    ],
    [
      "rt2*.bin",
      {
        "apt": ["firmware-misc-nonfree", "firmware-mediatek"]
      }
    ],
    [
      "rt3*.bin",
      {
        "apt": ["firmware-misc-nonfree", "firmware-mediatek"]
      }
    ],
    [
      "mediatek/*",
      {
        "apt": ["firmware-mediatek"]
      }
    ],
    [
      "mt76*",
      {
        "apt": ["firmware-mediatek"]
      }
    ],
    [
      "iwlwifi-*",
      {
        "apt": ["firmware-iwlwifi"]
      }
    ],
    [
      "intel/ibt-*",
      {
        "apt": ["firmware-intel-misc"]
      }
    ],
    [
      "ath9k_htc/*",
      {
        "apt": ["firmware-ath9k-htc"]
      }
    ],
    [
      "ath1*k/*",
      {
        "apt": ["firmware-atheros"]
      }
    ],
    [
      "ath3k-*",
      {
        "apt": ["firmware-atheros"]
      }
    ],
    [
      "qca/*",
      {
        "apt": ["firmware-atheros"]
      }
    ],
    [
      "brcm/*",
      {
        "apt": ["firmware-brcm80211"]
      }
    ],
    [
      "amdgpu/*",
      {
        "apt": ["firmware-amd-graphics"]
      }
    ],
    [
      "radeon/*",
      {
        "apt": ["firmware-amd-graphics"]
      }
    ],
    [
      "i915/*",
      {
        "apt": ["firmware-misc-nonfree"]
      }
    ],
    [
      "nvidia/*",
      {
        "apt": ["firmware-nvidia-graphics"]
      }
    ],
    [
      "*",
      {
        "apt": ["firmware-linux-nonfree"],
        "dnf": ["linux-firmware"],
        "pacman": ["linux-firmware"],
        "zypper": ["kernel-firmware"]
      }
    ]
