{
  "id": "vision",
  "name": "Visione e volti",
  "icon": "👁",
  "category": "percezione",
  "order": 60,
  "panel": "people",
  "description": "Webcam e riconoscimento facciale locale: chi è in casa, saluti personalizzati, nuove persone aggiunte da sole.",
  "toggle": {
    "env": "NUXIVA_VISION",
    "apply": [
      "vision"
    ]
  },
  "requires": {
    "video": true,
    "ram_gb": 2
  },
  "capabilities": [
    "Riconoscimento facciale offline",
    "Presenze in tempo reale",
    "Ospiti registrati da soli",
    "Filtro dei riflessi (specchi e vetri)",
    "Oggetti che hai in mano",
    "Lettura di etichette e testi",
    "Riparazione guidata via webcam con i cervelli che vedono",
    "Webcam a doppio sensore (colori + infrarosso) riconosciute al collegamento, senza riavvio",
    "Anti-foto e anti-schermo con l'infrarosso",
    "Gemelli e volti somiglianti distinti con un margine più severo, senza mischiare i loro campioni",
    "Il riconoscimento migliora da solo: campioni diversi, soglie per persona, infrarosso",
    "Memoria visiva a consenso: schermo e webcam diventano vettori temporanei, app sensibili mai guardate"
  ],
  "settings": [
    {
      "key": "NUXIVA_IR_MODE",
      "label": "Sensore infrarosso (webcam con doppio sensore)",
      "type": "select",
      "default": "auto",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "auto",
          "label": "Automatico: lo usa se c'è"
        },
        {
          "value": "off",
          "label": "Non usarlo"
        }
      ]
    },
    {
      "key": "NUXIVA_LIVENESS",
      "label": "Controllo anti-foto e anti-schermo (richiede l'infrarosso)",
      "type": "select",
      "default": "advisory",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "advisory",
          "label": "Segnala soltanto"
        },
        {
          "value": "strict",
          "label": "Rigido: foto e schermi non vengono riconosciuti"
        },
        {
          "value": "off",
          "label": "Disattivato"
        }
      ]
    },
    {
      "key": "NUXIVA_LIVENESS_MIN",
      "label": "Punteggio minimo per considerare vivo un volto (0,1 - 0,95)",
      "type": "number",
      "default": "0.55",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAMERA_RES",
      "label": "Risoluzione della webcam",
      "type": "select",
      "default": "auto",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "auto",
          "label": "Automatica (dal processore)"
        },
        {
          "value": "640x480",
          "label": "640x480 (leggera)"
        },
        {
          "value": "1280x720",
          "label": "1280x720"
        },
        {
          "value": "1920x1080",
          "label": "1920x1080 (massima nitidezza)"
        }
      ]
    },
    {
      "key": "NUXIVA_CAMERA_RGB",
      "label": "Webcam a colori: automatica oppure percorso (es. /dev/video0)",
      "type": "text",
      "default": "auto",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAMERA_IR",
      "label": "Sensore infrarosso: automatico, off oppure percorso (es. /dev/video2)",
      "type": "text",
      "default": "auto",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_FACE_AUTOIMPROVE",
      "label": "Il riconoscimento dei volti migliora da solo nel tempo",
      "type": "select",
      "default": "1",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "1",
          "label": "Sì: aggiunge campioni diversi e scarta quelli ridondanti"
        },
        {
          "value": "0",
          "label": "No: solo i campioni dell'iscrizione"
        }
      ]
    },
    {
      "key": "NUXIVA_FACE_ADAPTIVE",
      "label": "Soglia di riconoscimento calcolata per ogni persona",
      "type": "select",
      "default": "1",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "1",
          "label": "Sì"
        },
        {
          "value": "0",
          "label": "No: soglia unica"
        }
      ]
    },
    {
      "key": "NUXIVA_FACE_THRESHOLD",
      "label": "Soglia di somiglianza del volto (0,2 - 0,8)",
      "type": "number",
      "default": "0.40",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_FACE_MARGIN",
      "label": "Distacco minimo dalla seconda persona più simile (0 - 0,4)",
      "type": "number",
      "default": "0.05",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_FACE_TWIN_SIM",
      "label": "Due persone sono «somiglianti» oltre questa somiglianza (0,3 - 0,95)",
      "type": "number",
      "default": "0.55",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_FACE_TWIN_MARGIN",
      "label": "Distacco richiesto tra persone somiglianti, per esempio gemelli (0 - 0,5)",
      "type": "number",
      "default": "0.12",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_FACE_IR_WEIGHT",
      "label": "Peso dell'infrarosso nel riconoscimento (0 - 0,8)",
      "type": "number",
      "default": "0.35",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_CONSENT",
      "label": "Memoria visiva: schermo e webcam in un buffer temporaneo, solo su tuo consenso",
      "type": "select",
      "default": "0",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "0",
          "label": "No: non guardo lo schermo né la webcam per ricordare"
        },
        {
          "value": "1",
          "label": "Sì: tengo solo vettori numerici per pochi minuti, mai immagini"
        }
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_SOURCES",
      "label": "Fonti della memoria visiva (screen, webcam o screen,webcam)",
      "type": "text",
      "default": "screen,webcam",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_INTERVAL",
      "label": "Intervallo minimo tra due catture in millisecondi (250 - 120000)",
      "type": "number",
      "default": "2000",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_CEILING",
      "label": "Intervallo massimo quando nulla cambia, in millisecondi",
      "type": "number",
      "default": "30000",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_EMBEDDER",
      "label": "Come trasformare ogni immagine in numeri",
      "type": "select",
      "default": "tile",
      "apply": [
        "vision"
      ],
      "options": [
        {
          "value": "tile",
          "label": "Veloce e locale: forme e colori"
        },
        {
          "value": "vlm",
          "label": "Modello visivo locale: descrive la scena e ne ricava i numeri"
        }
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_VLM_MODEL",
      "label": "Modello visivo locale (solo con embedder vlm)",
      "type": "text",
      "default": "",
      "apply": [
        "vision"
      ]
    },
    {
      "key": "NUXIVA_CAPTURE_EMBED_MODEL",
      "label": "Modello locale di embedding del testo (solo con embedder vlm)",
      "type": "text",
      "default": "",
      "apply": [
        "vision"
      ]
    }
  ],
  "icon3d": "./icon.png",
