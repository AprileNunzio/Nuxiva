        {
          "value": "groq",
          "label": "Groq Whisper (whisper-large-v3-turbo, latenza ~150ms)"
        },
        {
          "value": "openai",
          "label": "OpenAI Whisper (whisper-1)"
        },
        {
          "value": "gemini",
          "label": "Google Gemini (gemini-2.5-flash audio nativo)"
        },
        {
          "value": "custom",
          "label": "Server personalizzato compatibile OpenAI (es. Gemma o Whisper su vLLM, LocalAI, anche locale)"
        }
