{
  "id": "music",
  "name": "Nexus Media Player",
  "icon": "🎵",
  "category": "intelligenza",
  "kind": "app",
  "order": 80,
  "panel": "music",
  "description": "Media center autonomo: libreria multimediale, video, playlist, karaoke sincronizzato, Chromecast e DLNA, link condivisi e riconoscimento vocale Nuxiva.",
  "toggle": {
    "env": "NUXIVA_MUSIC_ID",
    "apply": [
      "music"
    ]
  },
  "requires": {},
  "capabilities": [
    "Libreria con smistamento automatico",
    "Playlist normali e intelligenti",
    "Mix e radio infinita",
    "Chromecast, DLNA e schermo di Nuxiva",
    "Link condivisi a scadenza",
    "Server compatibile con le app musicali",
    "Riconoscimento ambientale"
  ],
