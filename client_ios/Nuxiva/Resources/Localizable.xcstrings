    "enroll.fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impronta del server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server fingerprint"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte du serveur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huella del servidor"
          }
        }
      }
    },
    "enroll.fingerprint.hint": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontala con l'impronta mostrata sul server. Se è diversa qualcuno potrebbe intercettare la rete: annulla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare it with the fingerprint shown on the server. If it differs someone may be intercepting the network: cancel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez-la avec l'empreinte affichée sur le serveur. Si elle diffère, quelqu'un intercepte peut-être le réseau : annulez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compárala con la huella que muestra el servidor. Si es distinta alguien podría estar interceptando la red: cancela."
          }
        }
      }
    },
    "enroll.fingerprint.match": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide, abbina"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It matches, pair"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle correspond, appairer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide, emparejar"
          }
        }
      }
    },
    "enroll.fingerprint.mismatch": {
      "extractionState": "manual",
      "localizations": {
