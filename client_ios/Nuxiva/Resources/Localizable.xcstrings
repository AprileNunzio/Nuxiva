    "enroll.code.hint": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: 192.168.1.20:8443. La connessione è sempre cifrata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 192.168.1.20:8443. The connection is always encrypted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : 192.168.1.20:8443. La connexion est toujours chiffrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: 192.168.1.20:8443. La conexión siempre está cifrada."
          }
