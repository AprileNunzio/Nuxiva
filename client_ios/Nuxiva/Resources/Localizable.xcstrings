          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No coincide"
          }
        }
      }
    },
    "enroll.hint": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul server apri Nodi e server, poi Abbina telefono: compaiono il QR e il codice."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the server open Nodes and servers, then Pair phone: the QR code and the code appear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le serveur, ouvrez Nœuds et serveurs puis Appairer un téléphone : le QR code et le code s'affichent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el servidor abre Nodos y servidores y luego Emparejar teléfono: aparecen el código QR y el código."
          }
        }
      }
    },
