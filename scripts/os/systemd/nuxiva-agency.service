[Unit]
Description=Nuxiva Agency (motore multi-agente dei progetti)
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-/etc/nuxiva/agency.env
ExecStartPre=-/usr/bin/install -d -m 0775 "/srv/nuxiva/condivisa/09 Progetti"
ExecStart=/opt/nuxiva-native/bin/nuxiva-agency
Restart=always
RestartSec=5
UMask=0002
StateDirectory=nuxiva/agency
StateDirectoryMode=0700
RuntimeDirectory=nuxiva/agency
RuntimeDirectoryMode=0700
ReadWritePaths=-/srv/nuxiva/condivisa
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
