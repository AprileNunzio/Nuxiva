[Unit]
Description=Nuxiva OS Ear (ascolto vocale e parola di attivazione)
After=nuxiva-supervisor.service
PartOf=nuxiva-supervisor.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONPATH=/opt/Nuxiva/installer_wizard:/opt/Nuxiva/installer_wizard/backend
EnvironmentFile=-/etc/nuxiva/nuxiva.env
ExecStart=/opt/nuxiva-ear/venv/bin/python /opt/Nuxiva/installer_wizard/features/ear/service.py
Restart=always
RestartSec=5
Nice=-5
CPUWeight=400
MemoryMax=3G

[Install]
WantedBy=multi-user.target
