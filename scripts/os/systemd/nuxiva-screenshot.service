[Unit]
Description=Nuxiva Screenshot (tasto Stamp verso la cartella condivisa)
After=local-fs.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/nuxiva-native/bin/nuxiva-screenshot run --env /etc/nuxiva/nuxiva.env --default-target /srv/nuxiva/condivisa
Restart=always
RestartSec=5
UMask=0027
StateDirectory=nuxiva-screenshot
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/nuxiva/condivisa /mnt /media /run/media
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/fb0 r
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
MemoryMax=384M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
