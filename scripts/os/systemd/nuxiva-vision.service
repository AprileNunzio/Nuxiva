[Unit]
Description=Nuxiva OS Vision (riconoscimento facciale locale)
After=nuxiva-supervisor.service
PartOf=nuxiva-supervisor.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
EnvironmentFile=-/etc/nuxiva/nuxiva.env
ExecStart=/opt/Nuxiva/installer_wizard/venv/bin/python /opt/Nuxiva/installer_wizard/features/vision/service.py
Restart=always
RestartSec=5
Nice=5
MemoryMax=1G
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
