[Unit]
Description=Nuxiva Display (gestore dei widget della pagina 80)
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-/etc/nuxiva/display.env
ExecStart=/opt/nuxiva-native/bin/nuxiva-display
Restart=always
RestartSec=5
UMask=0002
StateDirectory=nuxiva/display
StateDirectoryMode=0700
RuntimeDirectory=nuxiva/display
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
